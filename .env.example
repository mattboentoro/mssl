# ---------------------------------------------------------------------------
# MSSL — local development environment
# Copy to `.env` and fill in. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Local development (SQLite). The file lives next to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"
#
# Production (Azure Database for PostgreSQL flexible server). Also change
# `provider` in prisma/schema.prisma from "sqlite" to "postgresql".
# DATABASE_URL="postgresql://mssladmin:PASSWORD@mssl-db.postgres.database.azure.com:5432/mssl?sslmode=require"

# --- Auth.js --------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="dev-only-change-me-to-a-32-byte-random-string"

# Public base URL of the app. Required in production behind a proxy.
# AUTH_URL="https://mssl.example.com"
# AUTH_TRUST_HOST="true"

# --- Microsoft Entra ID (Azure AD) app registration -----------------------
# See README.md -> "Entra ID app registration" for the exact portal steps.
# The tenant ID is the directory GUID shown on the app registration overview.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=""

# --- Role resolution ------------------------------------------------------
# Object ID (GUID) of the `msslrefs` distribution list. Membership is resolved
# through Microsoft Graph POST /me/checkMemberGroups, because distribution
# lists are not emitted in token group claims.
# If this is blank the app falls back to resolving the group by display name.
MSSL_REFS_GROUP_ID=""
MSSL_REFS_GROUP_NAME="msslrefs"

# Object ID (GUID) of the security group whose members get admin rights.
MSSL_ADMIN_GROUP_ID=""

# Comma-separated UPN allowlist that also grants admin rights.
MSSL_ADMIN_UPNS="you@microsoft.com"

# --- Feature flags --------------------------------------------------------
# Dev-only auth bypass. Lets you sign in as a fake referee/admin/viewer with no
# Entra app registration. HARD-DISABLED when NODE_ENV=production.
DEV_AUTH_BYPASS="true"

# Include REPORT_SUBMITTED (not yet admin-confirmed) reports in the standings.
# Default true so a freshly submitted game report is immediately visible.
STANDINGS_INCLUDE_UNCONFIRMED="true"

# Scoreline awarded to the non-forfeiting side, "goalsFor-goalsAgainst".
STANDINGS_FORFEIT_SCORE="3-0"
