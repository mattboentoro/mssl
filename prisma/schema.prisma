// MSSL Prisma schema.
//
// PORTABILITY NOTE
// ----------------
// The schema is intentionally written to work unchanged on both SQLite (local dev)
// and PostgreSQL (production on Azure Database for PostgreSQL):
//
//   * No native database enums. Prisma's SQLite connector does not support `enum`
//     blocks, so every enum-like column is a `String` that is constrained in
//     application code by a TypeScript union + Zod enum (see `src/lib/enums.ts`).
//   * No `Json` columns. `AuditLog.metadata` and similar payloads are stored as
//     JSON-encoded `String` values.
//   * No database-specific attributes (`@db.*`), arrays, or `citext`.
//
// To target PostgreSQL, change `provider` below to "postgresql", point
// DATABASE_URL at the server, and run `npx prisma migrate dev --name init`
// against a fresh migrations directory. See README.md -> "Switching to PostgreSQL".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A competition year, e.g. "2026 Spring".
model Season {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  startsOn       DateTime
  endsOn         DateTime
  isActive       Boolean  @default(false)
  /// First sort key for this season's tables: POINTS or POINTS_PER_GAME.
  /// Points per game keeps a table fair while fixtures are unevenly played.
  tiebreakerMode String   @default("POINTS")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  matches            Match[]
  announcements      Announcement[]
  discipline         DisciplinaryAction[]
  adjustments        PointsAdjustment[]
  teamEntries        SeasonTeam[]
  memberships        TeamMembership[]
  captains           TeamCaptain[]
  rosterInvitations  RosterInvitation[]
  rosterJoinRequests RosterJoinRequest[]
}

/// Which division a club played in for one particular season.
///
/// Promotion and relegation mean a club's division is a fact *about a season*,
/// not a standing fact about the club. Without this table, moving a team would
/// silently rewrite history: last season's table is built from the club's
/// current division, so a promoted side would retroactively appear in the tier
/// it was promoted into, carrying results it earned in the tier below.
///
/// `Team.divisionId` remains the club's present-day division -- the default
/// used for a season that has no explicit entry, and the value new fixtures and
/// the team page read. This table overrides it wherever a season is in scope.
model SeasonTeam {
  id         String   @id @default(cuid())
  seasonId   String
  teamId     String
  divisionId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  season   Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  /// One division per club per season.
  @@unique([seasonId, teamId])
  @@index([seasonId, divisionId])
  @@index([teamId])
  @@index([divisionId])
}

/// A competitive tier, e.g. "Premier League".
///
/// Divisions and the teams inside them outlive any one season: a league's
/// structure is a standing fact, while a season is just the window of fixtures
/// played inside it. Deleting a season therefore removes that season's
/// fixtures and never touches the clubs.
model Division {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams          Team[]
  matches        Match[]
  entries        SeasonTeam[]
  freeAgentHopes FreeAgentRequest[]
}

model Team {
  id              String    @id @default(cuid())
  divisionId      String
  name            String
  slug            String    @unique
  shortName       String
  /// Home/first-choice kit colour as a `#rrggbb` hex string.
  colorPrimary    String    @default("#0f766e")
  /// Change/alternate kit colour, worn when the two sides would otherwise clash.
  colorAlternate  String    @default("#ffffff")
  logoBlobName    String?
  logoContainer   String?
  logoContentType String?
  logoEtag        String?
  logoUpdatedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  division           Division                @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  captains           TeamCaptain[]
  homeMatches        Match[]                 @relation("HomeTeam")
  awayMatches        Match[]                 @relation("AwayTeam")
  discipline         DisciplinaryAction[]
  adjustments        PointsAdjustment[]
  seasons            SeasonTeam[]
  memberships        TeamMembership[]
  rosterInvitations  RosterInvitation[]
  rosterJoinRequests RosterJoinRequest[]
  rescheduleRequests RescheduleRequest[]
  resultProposals    CaptainResultProposal[]
  scoreAppeals       ScoreAppeal[]
  refereeRatings     RefereeRating[]

  @@index([divisionId])
}

model TeamCaptain {
  id              String    @id @default(cuid())
  teamId          String
  seasonId        String?
  userId          String?
  name            String
  email           String?
  normalizedEmail String?
  sortOrder       Int       @default(0)
  status          String    @default("PENDING")
  assignedById    String?
  assignedAt      DateTime  @default(now())
  activatedAt     DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season     Season?  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user       AppUser? @relation("CaptainUser", fields: [userId], references: [id], onDelete: SetNull)
  assignedBy AppUser? @relation("CaptainAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([seasonId, teamId, sortOrder])
  @@index([teamId])
  @@index([seasonId, teamId])
  @@index([userId])
  @@index([normalizedEmail])
}

/// An application identity. Entra authenticates the person, while this row and
/// its relations are the sole authority for application access.
model AppUser {
  id              String    @id @default(cuid())
  entraObjectId   String?   @unique
  email           String
  normalizedEmail String    @unique
  displayName     String
  status          String    @default("PROVISIONAL")
  claimedAt       DateTime?
  lastSignInAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  rolesAssigned               GlobalRoleAssignment[]  @relation("RoleSubject")
  rolesGranted                GlobalRoleAssignment[]  @relation("RoleActor")
  rolesRevoked                GlobalRoleAssignment[]  @relation("RoleRevoker")
  memberships                 TeamMembership[]        @relation("MembershipUser")
  membershipsGranted          TeamMembership[]        @relation("MembershipActor")
  captainAssignments          TeamCaptain[]           @relation("CaptainUser")
  captainAssignmentsGranted   TeamCaptain[]           @relation("CaptainAssignedBy")
  notifications               Notification[]
  rosterInvitationsSent       RosterInvitation[]      @relation("RosterInvitationSender")
  rosterInvitationsReceived   RosterInvitation[]      @relation("RosterInvitationRecipient")
  rosterJoinRequests          RosterJoinRequest[]     @relation("RosterJoinRequester")
  rosterJoinRequestsDecided   RosterJoinRequest[]     @relation("RosterJoinDecider")
  rescheduleRequests          RescheduleRequest[]     @relation("RescheduleRequester")
  rescheduleResponses         RescheduleRequest[]     @relation("RescheduleResponder")
  rescheduleAdminReviews      RescheduleRequest[]     @relation("RescheduleAdminReviewer")
  rescheduleSlotsCreated      RescheduleSlot[]        @relation("RescheduleSlotCreator")
  resultProposals             CaptainResultProposal[] @relation("ResultProposer")
  resultProposalConfirmations CaptainResultProposal[] @relation("ResultConfirmer")
  scoreAppeals                ScoreAppeal[]           @relation("AppealSubmitter")
  scoreAppealDecisions        ScoreAppeal[]           @relation("AppealDecider")
  refereeRatings              RefereeRating[]
  referee                     Referee?
}

model GlobalRoleAssignment {
  id           String    @id @default(cuid())
  userId       String
  role         String
  assignedById String?
  assignedAt   DateTime  @default(now())
  revokedById  String?
  revokedAt    DateTime?

  user       AppUser  @relation("RoleSubject", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy AppUser? @relation("RoleActor", fields: [assignedById], references: [id], onDelete: SetNull)
  revokedBy  AppUser? @relation("RoleRevoker", fields: [revokedById], references: [id], onDelete: SetNull)

  @@unique([userId, role])
  @@index([role])
  @@index([assignedById])
  @@index([revokedById])
}

/// A portable serialization point for cross-row authorization invariants.
model AuthorizationInvariant {
  id        String   @id
  version   Int      @default(0)
  updatedAt DateTime @updatedAt
}

model TeamMembership {
  id           String    @id @default(cuid())
  seasonId     String
  teamId       String
  userId       String
  status       String    @default("ACTIVE")
  assignedById String?
  joinedAt     DateTime  @default(now())
  endedAt      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  season     Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       AppUser  @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy AppUser? @relation("MembershipActor", fields: [assignedById], references: [id], onDelete: SetNull)

  /// A membership is updated when a player changes teams, enforcing one team
  /// per person per season without provider-specific partial indexes.
  @@unique([seasonId, userId])
  @@index([seasonId, teamId, status])
  @@index([teamId])
}

model RosterInvitation {
  id              String    @id @default(cuid())
  seasonId        String
  teamId          String
  invitedById     String
  invitedUserId   String?
  email           String
  normalizedEmail String
  status          String    @default("PENDING")
  message         String?
  respondedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  season      Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy   AppUser  @relation("RosterInvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedUser AppUser? @relation("RosterInvitationRecipient", fields: [invitedUserId], references: [id], onDelete: SetNull)

  @@index([seasonId, teamId, status])
  @@index([normalizedEmail, status])
}

model RosterJoinRequest {
  id          String    @id @default(cuid())
  seasonId    String
  teamId      String
  requesterId String
  status      String    @default("PENDING")
  message     String?
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  requester AppUser  @relation("RosterJoinRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  decidedBy AppUser? @relation("RosterJoinDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([seasonId, teamId, requesterId])
  @@index([seasonId, teamId, status])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

/// An administrative change to a team's points total, almost always a deduction
/// (fielding an ineligible player, a forfeited fixture, unpaid fees).
///
/// This is the *only* sanctioned way to alter a league table. The rest of the
/// table stays derived from game reports; a deduction is recorded here as an
/// explicit, reasoned, audited row rather than by editing a result. A team
/// belongs to exactly one division, and a division to exactly one season, so
/// `teamId` alone already scopes the adjustment to a season.
model PointsAdjustment {
  id       String @id @default(cuid())
  seasonId String
  teamId   String
  /// Signed: negative deducts, positive awards. Never zero.
  points   Int
  /// Mandatory justification, shown on the public table.
  reason   String

  createdByEmail String?
  createdByName  String?
  createdAt      DateTime @default(now())

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([seasonId])
}

/// A league referee. `entraObjectId` / `email` link the record to the signed-in
/// Microsoft identity; membership of the `msslrefs` distribution list is checked
/// live against Microsoft Graph and is not stored here.
model Referee {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  entraObjectId String?  @unique
  userId        String?  @unique
  phone         String?
  certification String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  matches Match[]
  reports GameReport[]
  user    AppUser?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  ratings RefereeRating[]
}

/// A fixture. `status` is one of the MatchStatus values in `src/lib/enums.ts`.
/// `version` is an optimistic-concurrency counter used to make referee
/// self-assignment race safe.
///
/// There is no separate "lock" step: claiming a fixture IS the lock. Once
/// `refereeId` is set the fixture is frozen to everyone but that referee (who
/// may release it until they file a report) and league admins.
model Match {
  id                 String    @id @default(cuid())
  seasonId           String
  divisionId         String
  homeTeamId         String
  awayTeamId         String
  /// Where the fixture is played, as free text. Deliberately not a relation:
  /// organisers name pitches however they like week to week, and a schedule
  /// import must never be blocked because a pitch is not on a register.
  venueName          String?
  kickoffAt          DateTime
  /// Free text, not a number: a season has "1".."14" but also "Final",
  /// "Semi-final" and "Cup R1". Ordering is always by kick-off, never by this.
  matchweek          String
  /// False for anything that must not move the league table — finals,
  /// play-offs, friendlies. The fixture still appears in the schedule and
  /// still carries a result; the standings module simply skips it.
  countsForStandings Boolean   @default(true)
  status             String    @default("SCHEDULED")
  /// Which registered kit each side wears, one of KitChoice: PRIMARY | ALTERNATE.
  /// The colour itself is always read from the Team record so re-colouring a team
  /// keeps every fixture in sync.
  homeKit            String    @default("PRIMARY")
  awayKit            String    @default("ALTERNATE")
  refereeId          String?
  assignedAt         DateTime?
  version            Int       @default(0)
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  season             Season                 @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  division           Division               @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  homeTeam           Team                   @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam           Team                   @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)
  referee            Referee?               @relation(fields: [refereeId], references: [id], onDelete: SetNull)
  report             GameReport?
  discipline         DisciplinaryAction[]
  rescheduleRequests RescheduleRequest[]
  resultProposal     CaptainResultProposal?
  scoreAppeals       ScoreAppeal[]
  refereeRatings     RefereeRating[]

  @@index([seasonId])
  @@index([divisionId])
  @@index([refereeId])
  @@index([kickoffAt])
  @@index([status])
}

model RescheduleRequest {
  id                   String    @id @default(cuid())
  matchId              String
  requestingTeamId     String
  requestedById        String
  slotId               String?
  activeSlotKey        String?   @unique
  legacySlotExempt     Boolean   @default(false)
  proposedKickoffAt    DateTime?
  proposedVenueName    String?
  reason               String
  originalKickoffAt    DateTime?
  originalVenueName    String?
  expectedMatchVersion Int?
  openMatchKey         String?   @unique
  status               String    @default("PENDING_OPPONENT")
  respondedById        String?
  responseNote         String?
  respondedAt          DateTime?
  adminReviewedById    String?
  adminReviewNote      String?
  adminReviewedAt      DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  match           Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  requestingTeam  Team            @relation(fields: [requestingTeamId], references: [id], onDelete: Cascade)
  requestedBy     AppUser         @relation("RescheduleRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  slot            RescheduleSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  respondedBy     AppUser?        @relation("RescheduleResponder", fields: [respondedById], references: [id], onDelete: SetNull)
  adminReviewedBy AppUser?        @relation("RescheduleAdminReviewer", fields: [adminReviewedById], references: [id], onDelete: SetNull)

  @@index([matchId, status])
  @@index([requestingTeamId, status])
  @@index([slotId])
  @@index([adminReviewedById])
}

model RescheduleSlot {
  id          String    @id @default(cuid())
  kickoffAt   DateTime
  venueName   String
  status      String    @default("AVAILABLE")
  createdById String?
  disabledAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy AppUser?            @relation("RescheduleSlotCreator", fields: [createdById], references: [id], onDelete: SetNull)
  requests  RescheduleRequest[]

  @@unique([kickoffAt, venueName])
  @@index([status, kickoffAt])
  @@index([createdById])
}

model CaptainResultProposal {
  id              String    @id @default(cuid())
  matchId         String    @unique
  submittedById   String
  submittedTeamId String
  homeScore       Int
  awayScore       Int
  homeForfeit     Boolean   @default(false)
  awayForfeit     Boolean   @default(false)
  notes           String?
  status          String    @default("PENDING_OPPONENT")
  confirmedById   String?
  confirmedAt     DateTime?
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  submittedBy   AppUser  @relation("ResultProposer", fields: [submittedById], references: [id], onDelete: Cascade)
  submittedTeam Team     @relation(fields: [submittedTeamId], references: [id], onDelete: Cascade)
  confirmedBy   AppUser? @relation("ResultConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
}

model ScoreAppeal {
  id                      String    @id @default(cuid())
  matchId                 String
  teamId                  String
  submittedById           String
  reason                  String
  originalReportId        String
  originalMatchVersion    Int
  originalMatchStatus     String
  originalReportUpdatedAt DateTime
  originalHomeScore       Int
  originalAwayScore       Int
  originalHomeForfeit     Boolean
  originalAwayForfeit     Boolean
  requestedHomeScore      Int
  requestedAwayScore      Int
  requestedHomeForfeit    Boolean
  requestedAwayForfeit    Boolean
  status                  String    @default("PENDING")
  openKey                 String?   @unique
  decidedById             String?
  decisionNote            String?
  decidedAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  submittedBy AppUser  @relation("AppealSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)
  decidedBy   AppUser? @relation("AppealDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([matchId, teamId])
  @@index([status])
}

model RefereeRating {
  id        String   @id @default(cuid())
  matchId   String
  refereeId String
  teamId    String
  ratedById String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  match   Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  referee Referee @relation(fields: [refereeId], references: [id], onDelete: Cascade)
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  ratedBy AppUser @relation(fields: [ratedById], references: [id], onDelete: Cascade)

  @@unique([matchId, teamId])
  @@index([refereeId])
}

/// The referee's official record of a match. One per match.
///
/// Goalscorers are deliberately NOT tracked: the referee records the final
/// score and any disciplinary action, nothing else.
model GameReport {
  id             String    @id @default(cuid())
  matchId        String    @unique
  /// Null when a league admin entered the result directly — an override on a
  /// fixture whose referee never filed anything still has to produce a report,
  /// because the standings are derived from reports and nothing else.
  refereeId      String?
  homeScore      Int       @default(0)
  awayScore      Int       @default(0)
  homeForfeit    Boolean   @default(false)
  awayForfeit    Boolean   @default(false)
  notes          String?
  incidentReport String?
  misconduct     String?
  /// One of GameReportStatus: SUBMITTED | CONFIRMED | DISPUTED
  status         String    @default("SUBMITTED")
  submittedAt    DateTime  @default(now())
  confirmedAt    DateTime?
  confirmedById  String?
  disputeReason  String?
  overrideReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  match      Match                @relation(fields: [matchId], references: [id], onDelete: Cascade)
  referee    Referee?             @relation(fields: [refereeId], references: [id], onDelete: Cascade)
  discipline DisciplinaryAction[]

  @@index([refereeId])
  @@index([status])
}

/// A card or league sanction charged to a team.
///
/// Two sources feed this table:
///   * REFEREE — filed as part of a game report, so `gameReportId` and
///     `matchId` are both set.
///   * ADMIN   — a league-issued sanction added in Game Administration, which
///     may not relate to any single fixture, so both are null.
///
/// `playerName` is free text. The league does not maintain squad lists, so
/// there is no player record to point at.
///
/// A row may also carry a suspension. `gamesSuspended` is the ban length in
/// fixtures and doubles as the review state for red cards:
///   * null — no ban attached. Every yellow starts here, and a red card sits
///     here until an administrator has reviewed it.
///   * 0    — reviewed, no ban warranted.
///   * > 0  — banned for that many of the team's next fixtures.
/// Which fixtures a ban actually covers is derived at read time from the
/// schedule (see `src/lib/suspensions.ts`) rather than stored, so that
/// rescheduling a fixture cannot strand a ban.
model DisciplinaryAction {
  id               String   @id @default(cuid())
  seasonId         String
  teamId           String
  gameReportId     String?
  matchId          String?
  playerName       String
  /// One of CardType: YELLOW | RED
  type             String
  /// Minute of the match, when it came from a game report.
  minute           Int?
  note             String?
  /// One of DisciplinarySource: REFEREE | ADMIN
  issuedBy         String   @default("REFEREE")
  /// Ban length in fixtures. Null means undecided; see the model comment.
  gamesSuspended   Int?
  /// One of SuspensionReason: ACCUMULATED_YELLOWS | RED_CARD | LEAGUE_SANCTION
  suspensionReason String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  season     Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team       Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  gameReport GameReport? @relation(fields: [gameReportId], references: [id], onDelete: Cascade)
  match      Match?      @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@index([seasonId])
  @@index([teamId])
  @@index([gameReportId])
  @@index([matchId])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String
  body        String
  pinned      Boolean  @default(false)
  publishedAt DateTime @default(now())
  authorName  String   @default("MSSL Board")
  seasonId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  season Season? @relation(fields: [seasonId], references: [id], onDelete: SetNull)

  @@index([publishedAt])
}

model Document {
  id          String   @id @default(cuid())
  title       String
  description String?
  /// One of DocumentCategory: RULES | FORMS | POLICY | OTHER
  category    String   @default("OTHER")
  url         String
  fileType    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

/// Append-only trail of every privileged mutation.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  actorName  String?
  actorRole  String?
  action     String
  entity     String
  entityId   String
  /// JSON-encoded payload (kept as text so the schema stays portable).
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorEmail])
}

/// A player asking the league to find them a team.
///
/// Not a squad record: MSSL keeps no player register, and referees type player
/// names as free text on a game report. This is an expression of interest that
/// an administrator reads and acts on off-site, by putting the player in touch
/// with a captain who has room.
///
/// One open request per person, keyed on the e-mail of the Microsoft account
/// that submitted it. Submitting again edits the request already on file
/// rather than queueing a second one for the same player.
model FreeAgentRequest {
  id String @id @default(cuid())

  /// Entra object id of the submitter. Null for a dev-bypass session.
  submittedById    String?
  submittedByName  String
  submittedByEmail String  @unique

  /// Whole years of playing experience, as answered on the form.
  yearsExperience Int

  /// One of PlayerPosition: GOALKEEPER | DEFENDER | MIDFIELDER | FORWARD | ANY
  preferredPosition String

  /// Null means no preference, which is the form's default answer.
  preferredDivisionId String?

  /// Anything else the player wants a captain to know.
  notes String?

  /// One of FreeAgentStatus: PENDING | CONTACTED | PLACED | DECLINED
  status          String    @default("PENDING")
  reviewNote      String?
  reviewedAt      DateTime?
  reviewedByEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preferredDivision Division? @relation(fields: [preferredDivisionId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([preferredDivisionId])
}
